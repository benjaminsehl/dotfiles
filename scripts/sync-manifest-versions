#!/usr/bin/env bash
set -euo pipefail

REPO_ROOT=$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)
MANIFEST="$REPO_ROOT/manifest/setup.json"
mode=check

usage() {
  cat <<'USAGE'
Usage: scripts/sync-manifest-versions [--check|--write]

Compare the versions taught by Terminal Wizard with the commands on this Mac.
Use --write after an intentional tool update to refresh manifest/setup.json.
USAGE
}

case ${1:---check} in
  --check) mode=check ;;
  --write) mode='write' ;;
  --help) usage; exit 0 ;;
  *) printf 'Unknown option: %s\n' "$1" >&2; usage >&2; exit 2 ;;
esac
[[ $# -le 1 ]] || { usage >&2; exit 2; }

extract_version() {
  local output version
  if ! output=$("$@" 2>&1); then
    printf 'Could not read a version from %q: %s\n' "$1" "$output" >&2
    return 1
  fi
  version=$(printf '%s\n' "$output" | rg -o '[0-9]+([.][0-9]+){1,3}([-+][0-9A-Za-z.-]+)?' | sed -n '1p')
  if [[ -z $version ]]; then
    printf 'No semantic version found in %q output: %s\n' "$1" "$output" >&2
    return 1
  fi
  printf '%s\n' "$version"
}

detect_version() {
  case $1 in
    ghostty) extract_version ghostty --version ;;
    starship) extract_version starship --version ;;
    herdr) extract_version herdr --version ;;
    omp) extract_version omp --version ;;
    codex) extract_version codex --version ;;
    git) extract_version git --version ;;
    gh) extract_version gh --version ;;
    mise) extract_version mise --version ;;
    node) extract_version node --version ;;
    npm) extract_version npm --version ;;
    pnpm) extract_version pnpm --version ;;
    bun) extract_version bun --version ;;
    go) extract_version go version ;;
    python) extract_version python3 --version ;;
    uv) extract_version uv --version ;;
    nvim) extract_version nvim --version ;;
    rg) extract_version rg --version ;;
    fd) extract_version fd --version ;;
    fzf) extract_version fzf --version ;;
    bat) extract_version bat --version ;;
    eza) extract_version eza --version ;;
    zoxide) extract_version zoxide --version ;;
    direnv) extract_version direnv version ;;
    jq) extract_version jq --version ;;
    lazygit) extract_version lazygit --version ;;
    shellcheck) extract_version shellcheck --version ;;
    gitleaks) extract_version gitleaks version ;;
    *) printf 'No version detector for manifest tool %s\n' "$1" >&2; return 1 ;;
  esac
}

versioned_ids=(
  ghostty starship herdr omp codex git gh mise node npm pnpm bun go python uv
  nvim rg fd fzf bat eza zoxide direnv jq lazygit shellcheck gitleaks
)

working=$(mktemp "$REPO_ROOT/manifest/.setup-versions.XXXXXX")
next=$(mktemp "$REPO_ROOT/manifest/.setup-versions-next.XXXXXX")
cleanup() {
  rm -f -- "$working" "$next"
}
trap cleanup EXIT
cp "$MANIFEST" "$working"

for id in "${versioned_ids[@]}"; do
  version=$(detect_version "$id")
  awk -v id="$id" -v version="$version" '
    index($0, "\"id\":\"" id "\"") {
      sub(/\"version\":\"[^\"]*\"/, "\"version\":\"" version "\"")
    }
    { print }
  ' "$working" > "$next"
  mv "$next" "$working"
done

jq -e . "$working" >/dev/null

if cmp -s "$MANIFEST" "$working"; then
  printf 'manifest versions match the live workstation\n'
  exit 0
fi

if [[ $mode == check ]]; then
  printf 'manifest versions drift from the live workstation:\n' >&2
  diff -u "$MANIFEST" "$working" >&2 || true
  exit 1
fi

chmod 644 "$working"
mv "$working" "$MANIFEST"
printf 'updated manifest/setup.json from live command versions\n'
