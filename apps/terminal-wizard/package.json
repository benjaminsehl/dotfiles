{
  "name": "terminal-wizard",
  "version": "0.1.0",
  "description": "An interactive guide to Benjamin's real terminal setup, powered by wterm.",
  "private": true,
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "postinstall": "node scripts/prepare-node-pty.mjs",
    "prepare:pty": "node scripts/prepare-node-pty.mjs",
    "dev": "node scripts/run-local.mjs dev",
    "dev:web": "WRANGLER_LOG_PATH=.wrangler/wrangler.log vinext dev -H 127.0.0.1 -p 4317",
    "dev:pty": "tsx watch server/pty-server.ts",
    "build": "WRANGLER_LOG_PATH=.wrangler/wrangler.log vinext build",
    "build:vercel": "NITRO_PRESET=vercel vite build",
    "start": "node scripts/run-local.mjs start",
    "start:hosted": "node scripts/run-hosted.mjs",
    "start:web": "WRANGLER_LOG_PATH=.wrangler/wrangler.log vinext start -H 127.0.0.1 -p 4317",
    "test": "npm run test:launcher && npm run test:unit && npm run test:component && npm run build && node --test tests/rendered-html.test.mjs",
    "test:launcher": "node --test tests/hosted-launcher.test.mjs",
    "test:unit": "tsx --test tests/*.test.ts",
    "test:component": "vitest run --config vitest.config.ts",
    "typecheck": "tsc --noEmit",
    "audit:runtime": "npm audit --omit=dev --audit-level=high",
    "audit:full": "node scripts/audit.mjs",
    "lint": "eslint . --ignore-pattern dist --ignore-pattern .next --ignore-pattern .vercel --ignore-pattern .output",
    "check": "npm run typecheck && npm run lint && npm run test && npm run audit:runtime && npm run audit:full"
  },
  "dependencies": {
    "@wterm/core": "0.3.3",
    "@wterm/dom": "0.3.3",
    "@wterm/ghostty": "0.3.3",
    "@wterm/react": "0.3.3",
    "idb": "8.0.3",
    "just-bash": "2.14.5",
    "node-pty": "1.1.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "ws": "8.21.3"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.51.2",
    "@eslint/js": "9.39.4",
    "@next/eslint-plugin-next": "16.2.6",
    "@testing-library/react": "16.3.2",
    "@testing-library/user-event": "14.6.4",
    "@types/jsdom": "30.0.0",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@types/ws": "8.18.1",
    "@vitejs/plugin-react": "6.0.2",
    "@vitejs/plugin-rsc": "0.5.34",
    "eslint": "9.39.4",
    "eslint-plugin-jsx-a11y": "6.10.2",
    "eslint-plugin-react": "7.37.5",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "16.4.0",
    "jsdom": "30.0.1",
    "nitro": "3.0.260610-beta",
    "react-server-dom-webpack": "19.2.8",
    "tsx": "4.20.6",
    "typescript": "5.9.3",
    "typescript-eslint": "8.59.3",
    "vinext": "1.0.0-beta.5",
    "vite": "8.2.1",
    "vitest": "4.1.10",
    "wrangler": "4.120.1"
  },
  "type": "module",
  "allowScripts": {
    "esbuild@0.28.1": true,
    "esbuild@0.25.12": true,
    "fsevents@2.3.3": true,
    "node-pty@1.1.0": true,
    "workerd@1.20260804.1": true,
    "@mongodb-js/zstd": false,
    "node-liblzma": false
  }
}
