#!/usr/bin/env bash
set -u

resolve_source() {
  local source_path=${BASH_SOURCE[0]}
  while [[ -L $source_path ]]; do
    local source_dir
    source_dir=$(cd "$(dirname "$source_path")" && pwd)
    source_path=$(readlink "$source_path")
    [[ $source_path = /* ]] || source_path="$source_dir/$source_path"
  done
  cd "$(dirname "$source_path")/.." && pwd
}

REPO_ROOT=$(resolve_source)
if [[ -x /opt/homebrew/bin/brew ]]; then
  brew_prefix=/opt/homebrew
elif [[ -x /usr/local/bin/brew ]]; then
  brew_prefix=/usr/local
else
  brew_prefix=/usr/local
fi
export PATH="$HOME/.local/share/mise/shims:$HOME/.local/bin:/Applications/Ghostty.app/Contents/MacOS:$brew_prefix/sbin:$brew_prefix/bin:/usr/bin:/bin:/usr/sbin:/sbin"

status=0

run_check() {
  printf '\n== %s ==\n' "$1"
  shift
  "$@" || status=1
}

empty_check() {
  label=$1
  shift
  printf '\n== %s ==\n' "$label"
  if output=$("$@" 2>&1); then
    if [[ -z $output ]]; then
      printf 'none\n'
    else
      printf '%s\n' "$output" >&2
      status=1
    fi
  else
    printf '%s\n' "$output" >&2
    status=1
  fi
}

assert_check() {
  label=$1
  expected=$2
  shift 2
  printf '\n== %s ==\n' "$label"
  if output=$("$@" 2>&1) && [[ $output == "$expected" ]]; then
    printf '%s\n' "$output"
  else
    printf 'expected %q, got %q\n' "$expected" "$output" >&2
    status=1
  fi
}

version_check() {
  label=$1
  shift
  if output=$("$@" 2>&1); then
    printf '%-8s %s\n' "$label" "$output"
  else
    printf '%-8s unavailable (%s)\n' "$label" "$output"
    status=1
  fi
}

run_check "Homebrew" brew doctor
run_check "Brewfile" brew bundle check --file "$REPO_ROOT/Brewfile"
run_check "Dotfile links" "$REPO_ROOT/scripts/check-links"
empty_check "Outdated Homebrew packages" env HOMEBREW_NO_AUTO_UPDATE=1 brew outdated --quiet
assert_check "Outdated mise runtimes" '{}' mise outdated --json
run_check "Ghostty config" ghostty +validate-config
run_check "Codex approval defaults" "$REPO_ROOT/bin/configure-codex" --check
run_check "Herdr config" herdr config check
assert_check "OMP approval mode" write omp config get tools.approvalMode
assert_check "OMP secret protection" true omp config get secrets.enabled
run_check "Herdr OMP integration" bash -c 'herdr integration status | grep "omp: current"'
run_check "Herdr Codex integration" bash -c 'herdr integration status | grep "codex: current"'
run_check "GitHub authentication" gh auth status
run_check "Private file modes" "$REPO_ROOT/scripts/check-modes"

printf '\n== Core versions ==\n'
version_check git git --version
version_check gh gh --version
version_check node node --version
version_check npm npm --version
version_check pnpm pnpm --version
version_check bun bun --version
version_check go go version
version_check python python3 --version
version_check uv uv --version
version_check mise mise --version
version_check ghostty ghostty --version
version_check herdr herdr --version
version_check omp omp --version
version_check codex codex --version
version_check nvim nvim --version

exit "$status"
