#!/usr/bin/env bash
set -euo pipefail

resolve_source() {
  local source_path=${BASH_SOURCE[0]}
  while [[ -L $source_path ]]; do
    local source_dir
    source_dir=$(cd "$(dirname "$source_path")" && pwd)
    source_path=$(readlink "$source_path")
    [[ $source_path = /* ]] || source_path="$source_dir/$source_path"
  done
  cd "$(dirname "$source_path")/.." && pwd
}

usage() {
  cat <<'USAGE'
Usage: terminal-wizard [option]

Run the local, interactive course for this workstation.

  --production   Build, then run the production-local server
  --check        Run the complete Terminal Wizard verification suite
  --help         Show this help

With no option, starts the development server at http://127.0.0.1:4317.
Dependencies are installed from package-lock.json only when its checksum changes.
USAGE
}

mode=development
case ${1:-} in
  "") ;;
  --production) mode=production ;;
  --check) mode=check ;;
  --help) usage; exit 0 ;;
  *) printf 'Unknown option: %s\n' "$1" >&2; usage >&2; exit 2 ;;
esac
[[ $# -le 1 ]] || { printf 'Only one option is supported.\n' >&2; usage >&2; exit 2; }

REPO_ROOT=$(resolve_source)
APP_ROOT="$REPO_ROOT/apps/terminal-wizard"
LOCKFILE="$APP_ROOT/package-lock.json"
STAMP="$APP_ROOT/node_modules/.terminal-wizard-lock-sha256"

command -v npm >/dev/null 2>&1 || {
  printf 'npm is unavailable. Open a fresh shell after applying the dotfiles.\n' >&2
  exit 1
}

expected_lock=$(shasum -a 256 "$LOCKFILE" | awk '{print $1}')
installed_lock=
if [[ -r $STAMP ]]; then
  IFS= read -r installed_lock < "$STAMP"
fi

if [[ ! -d $APP_ROOT/node_modules || $installed_lock != "$expected_lock" ]]; then
  printf 'Installing Terminal Wizard dependencies from package-lock.json…\n'
  (cd "$APP_ROOT" && npm ci)
  printf '%s\n' "$expected_lock" > "$STAMP"
fi

cd "$APP_ROOT"
case $mode in
  development) exec npm run dev ;;
  production)
    npm run build
    exec npm start
    ;;
  check) exec npm run check ;;
esac
